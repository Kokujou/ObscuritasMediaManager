{
    "runtime": "%%ClientTargetRuntime%%",
    "defaultVariables": null,
    "documentGenerator": {
        "fromDocument": {
            "url": "https://localhost/ObscuritasMediaManager/Backend/swagger/swagger/swagger.json",
            "output": null
        }
    },
    "codeGenerators": {
        "openApiToTypeScriptClient": {
            "jsonLibrary": "SystemTextJson",
            "className": "{controller}Client",
            "moduleName": "",
            "namespace": "",
            "typeScriptVersion": 4.4,
            "template": "Fetch",
            "promiseType": "Promise",
            "dateTimeType": "Date",
            "nullValue": "undefined",
            "generateClientClasses": true,
            "generateClientInterfaces": false,
            "generateOptionalParameters": true,
            "wrapDtoExceptions": false,
            "wrapResponses": false,
            "exportTypes": true,
            "generateResponseClasses": true,
            "responseClass": "SwaggerResponse",
            "exceptionClass": "SwaggerException",
            "useTransformOptionsMethod": false,
            "useTransformResultMethod": false,
            "clientBaseClass": null,
            "generateDtoTypes": true,
            "operationGenerationMode": "MultipleClientsFromOperationId",
            "markOptionalProperties": false,
            "generateCloneMethod": true,
            "typeStyle": "Class",
            "generateDefaultValues": false,
            "excludedTypeNames": [],
            "handleReferences": true,
            "generateConstructorInterface": true,
            "convertConstructorInterfaceData": false,
            "importRequiredTypes": true,
            "useGetBaseUrlMethod": false,
            "baseUrlTokenName": "%%TSBaseUrlTokenName%%",
            "queryNullValue": "",
            "output": "%%TSProjectName%%.ts",
            "useAbortSignal": true,
            "generateExceptionClasses": true,
            "defaultReferenceTypeNullHandling": "NotNull",
            "templateDirectory": "../hotfix_template",
            "inlineNamedAny": false
        }
    }
}
